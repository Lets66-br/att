<?php
$num1 = (float) readline("Digite o primeiro número: ");
$num2 = (float) readline("Digite o segundo número: ");

echo "Soma: " . ($num1 + $num2);
echo " Subtração: " . ($num1 - $num2);
echo " Multiplicação: " . ($num1 * $num2);

if ($num2 != 0) {
    echo "Divisão: " . ($num1 / $num2);
} else {
    echo "Divisão: Não é possível dividir por zero.";
}
